# ── Gemini (Architectural Reasoning) ───────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# Text reasoning model (used for concept generation, critique, design intent)
GEMINI_MODEL=gemini-2.0-flash

# ── Groq (Fast Interaction Layer) ─────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# Default text model for requirement parsing, edit interpretation, etc.
GROQ_MODEL=openai/gpt-oss-120b

# Vision model for floor plan image analysis
GROQ_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (leave empty for localhost defaults)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
